# Copy to .env and fill in. Mirrors instructions.md §10.

# Models / LLM
LLM_PROVIDER=anthropic                    # anthropic|ollama|deepseek|gemini|groq|gateway
                                           # used when a novel has no provider_config row (§10)
LLM_MODEL_TRANSLATE=claude-opus-4-8       # stronger model
TRANSLATION_CHUNK_TOKENS=6000             # estimated source-token ceiling per LLM call
LLM_MODEL_EXTRACT=claude-haiku-4-5        # cheaper model
LLM_MODEL_ASK=claude-haiku-4-5            # reader-facing answers; falls back to extract if unset
EMBED_PROVIDER=ollama                     # ollama|gemini|openrouter|gateway; independent retrieval backend
EMBED_MODEL=nomic-embed-text              # dimension MUST match chunk/entity.embedding VECTOR(768) (0004)
EMBED_DIM=768                             # vectors with another width are stored as NULL; retrieval skips them
GLOSSARY_MIN_PROPOSALS=2                  # distinct chapters that must independently propose
                                           # the same source->target term before RESOLVE locks
                                           # it. Locked terms are immutable and enforced on
                                           # every later translation, so 1 bad term is
                                           # unrecoverable; 1 = lock on first sight (0016)
PROMPT_VERSION=1                          # bump to invalidate LLM-result cache
CONFIG_VERSION=1                          # bump to invalidate LLM-result cache (config change)
                                           # RECORDS extraction identity is NOT an env knob:
                                           # the prompt, check and ontology versions are
                                           # stored on record_generation, so changing one
                                           # opens a new generation and re-extracts in
                                           # chapter order rather than silently reinterpreting
                                           # published rows.
DEEPSEEK_API_KEY=                         # only used when LLM_PROVIDER=deepseek (or a novel's
                                           # own provider_config picks deepseek with no key set)
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=                             # only used when LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=                           # only for LLM_PROVIDER=gemini; per-novel keys
                                           # belong in provider_config (encrypted), not here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=                       # OpenRouter embedding API key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-novel provider configuration (PLAN.md Phase N3/N4) — a novel's own provider/models/
# API key, encrypted at rest, overriding LLM_PROVIDER above for that novel only.
INGEST_PROVIDER_CONFIG_KEY=               # base64, 32 bytes; ingest-api encrypts with this
PROVIDER_CONFIG_ENCRYPTION_KEY=           # same key, base64; pipeline/askai decrypt with this

# Pipeline worker (Python)
OLLAMA_HOST=http://localhost:11434        # completion or embedding backend when selected
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1  # ingest-api may query only these hosts' fixed
                                           # /api/tags endpoint for the web model picker.
                                           # Add cj-desktop after its Ollama API is reachable.
OLLAMA_TIMEOUT_SECONDS=120                # httpx client timeout for a SINGLE Ollama call;
                                           # a full-chapter TRANSLATE prompt on slow/local
                                           # hardware can need much longer than this default
GRAPH_OLLAMA_FIRST_TOKEN_SECONDS=900      # graph-stream prefill deadline: Ollama emits
                                           # no bytes while evaluating the prompt
GRAPH_OLLAMA_TIMEOUT_SECONDS=30            # graph-stream idle deadline between tokens
# GRAPH_OLLAMA_TOTAL_TIMEOUT_SECONDS=1800  # optional hard per-call wall-clock cap, on top
                                           # of the idle/first-token stall detectors above.
                                           # Unset (default) means no cap: an actively
                                           # streaming call is never killed just for being
                                           # slow, only for going idle past the budgets above.
GRAPH_OLLAMA_NUM_CTX_TARGET=16384          # the ASK, not the answer: prepare() requests
                                           # this, then pins whatever context length
                                           # Ollama actually loaded the model with on
                                           # that host (graph_rebuild.discover_num_ctx) --
                                           # a card too small for this target fails
                                           # loudly at prepare() time instead of an OOM
                                           # or a truncated response mid-chapter.
GRAPH_OLLAMA_NUM_PREDICT=4096
# Hosted graph extraction budgets. Windows are packed by measured request tokens;
# character caps remain safety bounds. Context is model capacity; request is the
# per-call provider/account admission ceiling (input + reserved output), and both
# are part of request identity because they change passage grouping. 8000 matches
# Groq's published free-plan GPT-OSS TPM example; set it to the account/model limit.
HOSTED_GRAPH_CONTEXT_TOKENS=32768
HOSTED_GRAPH_OUTPUT_TOKENS=2048
HOSTED_GRAPH_REQUEST_TOKENS=8000
GRAPH_MAX_CONCURRENT_CALLS=1               # how many independent extraction calls (fact
                                           # verification, claim focuses, alignment
                                           # windows) may be in flight at once. Scheduling
                                           # only: it never enters revision identity or the
                                           # completion cache key, so it cannot change what
                                           # a finished call contains. 1 (default) keeps a
                                           # loopback Ollama serving one model out of VRAM
                                           # pressure; raise it for hosted providers.
# GRAPH_OLLAMA_THINK=false                 # reasoning models only (granite4.2, …). Unset =
                                           # omit the flag; set = pinned into revision identity

EVENT_REMOTE_TIMEOUT_SECONDS=300           # wall-clock bound for event extraction served by a
                                           # hosted provider (event_rebuild prepare --provider)
NAMES_OLLAMA_FIRST_TOKEN_SECONDS=900   # CHARACTER_NAMES prefill deadline: it batches up
                                           # to 8 KB of source per call, so prompt-eval
                                           # dominates on CPU and the flat 120s default
                                           # aborts before the first token
NAMES_OLLAMA_TIMEOUT_SECONDS=120          # idle deadline between tokens once generating
NAMES_OLLAMA_TOTAL_TIMEOUT_SECONDS=1800   # hard per-call deadline
NAMES_OLLAMA_NUM_CTX=16384                # must exceed the 8 KB batch, or the prompt is
                                           # silently truncated (llama3.2:3b defaults 4096)
RESOLVE_OLLAMA_FIRST_TOKEN_SECONDS=900     # RESOLVE chapter proposal/per-name prefill deadline
RESOLVE_OLLAMA_TIMEOUT_SECONDS=120         # idle deadline between generated JSON tokens
RESOLVE_OLLAMA_TOTAL_TIMEOUT_SECONDS=1800  # hard deadline for one RESOLVE model call
RESOLVE_OLLAMA_NUM_CTX=16384               # context available to the chapter proposal
# BOOK_OLLAMA_LOCK_DIR=/tmp/book-ollama-UID # same path for worker, Ask AI and benchmark;
                                           # share this directory across containers too
LLM_GATEWAY_ADDR=localhost:8081           # required by LLM_PROVIDER=gateway
LLM_GATEWAY_BACKEND=local_gpu              # local_gpu|hosted
LLM_GATEWAY_PROVIDER=ollama                # gateway provider identity
LLM_GATEWAY_MAX_OUTPUT_TOKENS=8192
PIPELINE_QUEUE_TIMEOUT=1                  # idle polling interval (bounded to 0.1–1s)
PIPELINE_VISIBILITY_TIMEOUT=300           # crash-recovery reaper (§6.3): requeue a
                                           # claim with no heartbeat for this many seconds
PIPELINE_REAPER_INTERVAL=5                # seconds between reaper sweeps

# Batching -- NOT YET IMPLEMENTED (M3.3). BatchManager is deliberately only an
# interface today; providers still execute their default batches sequentially, and
# no code reads any of these four. Kept as the documented shape of that seam.
BATCH_MAX=256
BATCH_WINDOW_SECONDS=300
MAX_RETRY=3
MAX_INFLIGHT_BATCHES=4

# Scraper
SCRAPE_RATE_PER_SEC=0.3
SCRAPE_JITTER_MS=800
SCRAPE_USER_AGENT="novel-engine/0.1 (+contact)"
CONTENT_LEN_FLOOR=800

# Infra (defaults match deploy/docker-compose.yml)
DATABASE_URL=postgres://engine:engine@localhost:5432/novel_engine
# reader-api uses two separate pools and immediately SET ROLEs each connection. In local
# development both may authenticate through the compose owner; production login roles
# should be members of only rls_reader or reader_progress_writer respectively. Because the
# compose owner is a superuser and may SET ROLE to anything, that boundary is only real
# once each service logs in as its own least-privileged role.
READER_DATABASE_URL=postgres://engine:engine@localhost:5432/novel_engine
PROGRESS_DATABASE_URL=postgres://engine:engine@localhost:5432/novel_engine
READER_LISTEN_ADDR=:8081
ASKAI_URL=http://localhost:8082
ASKAI_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
ASKAI_DATABASE_URL=postgres://engine:engine@localhost:5432/novel_engine
INGEST_API_URL=http://localhost:8080
# Shared secret gating ingest-api's POST /novels — the only route it protects; reader-api
# is the only intended caller (proxying novel creation for the browser).
INGEST_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
ASKAI_PORT=8082
ASKAI_TIMEOUT_SECONDS=120
REDIS_URL=redis://localhost:6379
OBJECT_STORE_ENDPOINT=http://localhost:9000
TEXTPROC_GRPC_ADDR=textproc:50051
TEXTPROC_BACKEND=python                 # set grpc when the Rust textproc service is running
TEXTPROC_TIMEOUT_SECONDS=10
TEXTPROC_MATCHER_CACHE_CAPACITY=128
