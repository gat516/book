[Unit]
Description=novel-engine web UI (:5173)
After=network-online.target novel-reader-api.service
Wants=network-online.target
PartOf=novel-engine.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/services/web
EnvironmentFile=@REPO@/.env
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=novel-engine.target
