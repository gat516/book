[Unit]
Description=novel-engine pipeline worker (drains jobs:pending)
After=network-online.target novel-ollama-tunnel.service
Wants=network-online.target novel-ollama-tunnel.service
PartOf=novel-engine.target
# See the note in novel-ingest-api.service: the default start limit would let a
# restart storm latch this unit into "failed" permanently. This is the worker whose
# absence strands claims in jobs:processing, so it must never stop being restarted.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/services/pipeline
EnvironmentFile=@REPO@/.env
ExecStart=@REPO@/services/pipeline/.venv/bin/python -m pipeline.worker
Restart=always
RestartSec=5

[Install]
WantedBy=novel-engine.target
