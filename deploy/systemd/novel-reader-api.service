[Unit]
Description=novel-engine reader API (:8081)
After=network-online.target
Wants=network-online.target
PartOf=novel-engine.target
# Never stop retrying. The default (5 starts / 10s, then give up and stay failed)
# would recreate the exact failure this supervision exists to prevent: a dead worker
# that nobody restarts. Infra being down is a normal transient here -- the service
# crashes, waits RestartSec, and self-heals when Postgres/Redis come back.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/services/reader-api
EnvironmentFile=@REPO@/.env
ExecStartPre=/usr/bin/go build -o @REPO@/services/reader-api/reader-api .
ExecStart=@REPO@/services/reader-api/reader-api
Restart=always
RestartSec=5

[Install]
WantedBy=novel-engine.target
